# I todo sono della persona: /fine li aggiunge con -f solo verso un remote privato.
data/todo/
# Il lucchetto dell'archivio. git add -f scavalca questa riga: lo tiene fuori l'esclusione in /fine.
data/todo/*.lock
# Le copie di /segnala restano su questo computer.
data/segnalazioni/
# Lo stato di /monitor (cursori, cartelle delle run): è della persona.
data/monitor/
# La coda della telemetria (bin/telemetria.py).
data/telemetria/
# L'interruttore e le cartelle della memoria facoltativa (bin/memoria.py): restano su questo computer.
data/memoria/
# Le note della memoria curata (Melchior): sono della persona, mai nel repository. /fine le porta
# solo verso un remote privato verificato.
data/memory/
# Il segno della FASE 9 di /setup: dice che questa installazione è configurata.
data/setup-fatto
# La scelta fra aggiornamenti automatici e manuali (bin/aggiornamenti.py): è di chi usa Arturo.
data/aggiornamenti.json
# La copia dei settings di prima dell'installazione col plugin (4/11/2026, #4567): è di questo computer,
# /fine non la salva. Il puntatore della barra, arturo/radice, sta già sotto /arturo/.
/settings.json.prima-di-arturo
.credentials.json

