# Cache e temporanei
*.pyc
__pycache__/
*.swp
.DS_Store
*.bak
*.log

# File sensibili — MAI committare
*.env
*.key
*.pem
credentials.json
settings.local.json
secrets/
data/credentials/
# I todo sono della persona: /fine li aggiunge con -f solo verso un remote privato.
data/todo/
# Il lucchetto dell'archivio. git add -f scavalca questa riga: lo tiene fuori l'esclusione in /fine.
data/todo/*.lock
# Le copie di /segnala restano su questo computer.
data/segnalazioni/
# La coda della telemetria (bin/telemetria.py).
data/telemetria/
# L'interruttore e le cartelle della memoria facoltativa (bin/memoria.py): restano su questo computer.
data/memoria/
# Il segno della FASE 9 di /setup: dice che questa installazione è configurata.
data/setup-fatto
# La scelta fra aggiornamenti automatici e manuali (bin/aggiornamenti.py): è di chi usa Arturo.
data/aggiornamenti.json
.credentials.json

# Runtime Claude Code (generato localmente)
ide/
local/
logs/
downloads/
backups/
cache/
# Solo la cartella dei plugin installati da Claude Code, alla radice.
/plugins/
stats-cache.json
history.jsonl
telemetry/
statsig/
session-env/
debug/
projects/
file-history/
shell-snapshots/
plans/
sessions/
todos/
teams/
.last-update-result.json

# Handoff locali dei progetti (i mirror vivono in data/handoffs/)
HANDOFF_*.md
!data/handoffs/**/HANDOFF_*.md

# Client secret OAuth (onboarding gws) — MAI committare
client_secret*.json

# File personali dell'utente — non arrivano mai con un aggiornamento
CLAUDE.md
hooks/hosts-interni.local
hooks/api-fidate.local
# Le aggiunte ai comandi di Arturo (arturo personale): /fine le porta solo verso un remote privato.
/personale/

# Artefatti di lavoro dello strumento di design (screenshot, config locale)
.impeccable/

# I tipi e il tsconfig che Claude Code scrive accanto a un mod caricato da una cartella
# della persona (skills/dafare): li rigenera a ogni caricamento, non sono di Arturo.
skills/*/.claude-plugin/types/
skills/*/tsconfig.json

# File di lavoro che Claude Code crea in ~/.claude (15/10/2026): non sono config
*-unlock-*
*.bak-*
*.swo
Thumbs.db
.playwright-cli/
# Questi Claude Code li crea solo alla radice di ~/.claude: la / davanti non tocca una cartella
