{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "PROJECTS_BASE": "~/Documents/ClaudeCode",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "WebSearch",
      "WebFetch",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(cd:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh search:*)",
      "Bash(jq:*)",
      "Bash(claude --version)",
      "Bash(claude plugin list:*)",
      "Bash(claude plugin validate:*)",
      "Read(//tmp/**)",
      "mcp__playwright__*",
      "mcp__github__get_*",
      "mcp__github__list_*",
      "mcp__github__search_*",
      "Bash(bw status)",
      "Bash(bw list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(sed -n:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(file:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(realpath:*)",
      "Bash(date:*)",
      "Bash(printf:*)",
      "Bash(mkdir -p:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vue-tsc --noEmit:*)",
      "Bash(npx vue-tsc -b:*)",
      "Bash(npx vitest run:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(sudo rm *)",
      "Bash(chmod 777 *)",
      "Bash(> /dev/*)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git clean -fd*)",
      "Bash(git clean -f *)",
      "Bash(git branch -D*)",
      "Bash(git stash drop*)",
      "Bash(git push* +*)",
      "Bash(git -c *push*)",
      "Bash(git reflog expire*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git update-ref -d*)",
      "Bash(npm publish*)",
      "Bash(bw export:*)",
      "Bash(bw export)",
      "Bash(bw * export*)",
      "Bash(ln -sf /*)",
      "Bash(find * -exec *rm*)",
      "Bash(install -m 777 *)",
      "Bash(git config --global*)",
      "Read(~/.ssh/*)",
      "Read(~/.gnupg/*)",
      "Read(~/.aws/*)",
      "Read(~/.kube/*)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/id_dsa)",
      "Read(**/service-account*.json)",
      "Read(**/credentials.json)",
      "Read(**/.aws/credentials)",
      "Read(**/.pypirc)",
      "Read(**/secrets.env)",
      "Read(**/.secrets/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zshenv)",
      "Edit(~/.profile)",
      "Bash(git * push* +*)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright-ff__browser_run_code_unsafe",
      "mcp__claude-in-chrome__javascript_tool",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/data/credentials/**)",
      "Bash(del /s /q C:\\*)",
      "Bash(rd /s /q C:\\*)",
      "Bash(format C:\\*)"
    ],
    "ask": [
      "mcp__*__*delete*",
      "mcp__*__*remove*",
      "mcp__*__drop_table*",
      "mcp__*__drop_database*",
      "mcp__*__*destroy*",
      "mcp__*__*purge*",
      "mcp__*__*reset*",
      "mcp__*__*rebase*",
      "mcp__*__*merge*",
      "mcp__*__*pause*",
      "mcp__*__*restore*",
      "mcp__*__*deploy*",
      "mcp__*__*publish*",
      "mcp__*__*send*",
      "mcp__*__*push*",
      "mcp__*__*sql*",
      "mcp__*__*migrat*",
      "mcp__*__*schedule*",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(kubectl:*)",
      "Bash(sudo *)",
      "mcp__*__*reply*",
      "mcp__*__*forward*",
      "mcp__*__*share*",
      "mcp__*__create_event",
      "mcp__*__update_event",
      "mcp__*__respond_to_event",
      "mcp__*__add_*comment*",
      "mcp__*__create_*comment*",
      "mcp__*__create_pull_request*",
      "mcp__*__issue_write",
      "mcp__*__post_*",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(bw get:*)",
      "Bash(bw unlock:*)",
      "Bash(git commit --amend*)",
      "Bash(find * -execdir *)",
      "Bash(sort -o *)",
      "Bash(sort --output*)",
      "Bash(rclone config show*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-end.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/input-notifier-start.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/protect_claude_md.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/bash-dispatcher.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*[Dd]raft.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bozze-mcp-auto-approve.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "WebFetch|mcp__jina__.*|mcp__tavily__.*|mcp__playwright__browser_navigate|mcp__playwright-ff__browser_navigate|mcp__claude-in-chrome__navigate|mcp__claude-in-chrome__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/web-egress-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/emoji_remover.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/bin/telemetria-esito.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/prompt-injection-scanner.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/credential-leak-scanner.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/bin/telemetria-esito.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memoria-scrittura.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/typecheck-after-edit.py",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/inject-now.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memoria-richiamo.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memoria-subagente.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scheda-terminale.py",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/hooks/statusline.js",
    "refreshInterval": 30
  },
  "language": "italian",
  "outputStyle": "Guida",
  "alwaysThinkingEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Running a script that lives in the session scratchpad (python3, bash or node on a file under the scratchpad directory the harness names at the start of the session) is local, reversible work: allow. Long inline heredoc scripts are written to a scratchpad file first and then run.",
      "Test-bench work inside the session scratchpad: creating, filling and deleting subdirectories there (rm -rf of a scratchpad subdirectory, written literally or through a shell variable assigned to a scratchpad path in the same command), git archive or git clone of the user's local repositories into it, tar -x into it, and fake HOME directories inside it for isolated runs, also from background subagents: allow. It does NOT cover deleting anything outside the scratchpad, nor a variable whose value is not a scratchpad path.",
      "Copying a hook or ~/.claude/settings.json into the session scratchpad and editing or running THAT COPY and its test benches, including probe scripts that feed a JSON payload to a copy of bash-dispatcher.sh: allow. Installing the result back into ~/.claude follows Arturo's unlock rule.",
      "Local git housekeeping in the user's own repositories (under the projects folder PROJECTS_BASE or ~/.claude): deleting a LOCAL branch whose commits are already contained in another branch or still exist on the remote; git stash drop after the stash was saved as a patch file or verified as applied; git worktree remove and git worktree prune after uncommitted changes were saved: allow. NOT covered: deleting remote branches, git push --force, git reset --hard, git clean, git checkout -- <file>, or deleting work that exists nowhere else.",
      "git add per pathspec and git commit in the user's own repositories, when the user asked to save the work or a command such as /fine does it: allow. git push of the current branch to its own configured upstream, without force, when the user asked to publish or sync: allow."
    ],
    "soft_deny": [
      "$defaults",
      "Deleting or overwriting any *.env* file, or writes to any path, namespace, host or container carrying prod or production as a whole word."
    ],
    "environment": [
      "$defaults",
      "Scratch area: the per-session scratchpad directory that the harness names at the start of the session is Claude's own working area. Writing, running and deleting files there is routine and reversible.",
      "Sensitive data locations: ~/.ssh private keys, ~/.claude/.credentials.json, ~/.claude/data/credentials/, .env* files in the projects, browser profiles and password managers. None of it may enter a commit, a message, a document or a post.",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Network posture / host containment**: None configured — an ordinary personal computer with open internet",
      "**Trusted cloud buckets, internal package registry, data retention rules**: None configured",
      "**Sensitive remote targets**: any path, namespace, host or container carrying prod or production as a whole word"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      "client/node_modules",
      "server/node_modules",
      "frontend/node_modules",
      "app/node_modules"
    ],
    "baseRef": "head"
  }
}
